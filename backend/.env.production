# =============================================================================
# AdSync Production Environment — Live Deployment
# Target Domain: https://ads-manager.lazyskipper.shop
# =============================================================================

NODE_ENV="production"
PORT=4000

# Domain & CORS Setup
FRONTEND_URL="https://ads-manager.lazyskipper.shop"
BACKEND_URL="https://ads-manager.lazyskipper.shop"
CORS_ORIGIN="https://ads-manager.lazyskipper.shop"

# Live Database (PostgreSQL / Neon or Local PostgreSQL on cPanel)
# Connection string format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://lazyski1_ads-manager:24461139lazyskippeR@localhost:5432/lazyski1_ads-manager?schema=public&sslmode=prefer"
DIRECT_URL="postgresql://lazyski1_ads-manager:24461139lazyskippeR@localhost:5432/lazyski1_ads-manager?schema=public&sslmode=prefer"

# Auth / JWT & Token Encryption Secrets
JWT_SECRET="e98a12bc4f3a76e5d891b2c3d4e5f6a7890123456789abcdef0123456789abcd"
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Redis Cache (Upstash or Local Redis)
UPSTASH_REDIS_URL="rediss://default:your_upstash_token@your-endpoint.upstash.io:6379"

# Google Ads API Credentials
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""

# Meta Ads API Credentials
META_APP_ID=""
META_APP_SECRET=""

# TikTok Ads API Credentials
TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""

# Payment Gateways (bKash & Nagad)
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
NAGAD_BASE_URL="http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs"
