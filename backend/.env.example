# =============================================================================
# AdSync Backend — Environment Variables (MySQL 8+)
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# --- Database (MySQL 8+ — cPanel / PlanetScale / Railway / Aiven) -------------
DATABASE_URL="mysql://username:password@localhost:3306/dbname"

# --- Redis (Upstash — managed cloud Redis over TLS) -------------------------
# Use the rediss:// protocol URL (NOT the REST URL) for ioredis/BullMQ
UPSTASH_REDIS_URL="rediss://default:your_token@your-endpoint.upstash.io:6379"

# --- Auth / Security ---------------------------------------------------------
# Secret key for signing JWT tokens (min 32 chars, random string)
JWT_SECRET="CHANGE_ME_to_a_random_string_at_least_32_chars"

# AES-256 encryption key for encrypting OAuth tokens at rest (64 hex chars = 32 bytes)
TOKEN_ENCRYPTION_KEY="CHANGE_ME_64_hex_characters_representing_32_bytes_aes256_key"

# --- Google Ads API ----------------------------------------------------------
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""

# --- Meta (Facebook/Instagram) Ads API ---------------------------------------
META_APP_ID=""
META_APP_SECRET=""

# --- TikTok Ads API ----------------------------------------------------------
TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""

# --- AI / LLM Provider ------------------------------------------------------
AI_PROVIDER_API_KEY=""

# --- Stripe (Card Payments) --------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- bKash (Bangladesh Mobile Payments) --------------------------------------
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"

# --- Nagad (Bangladesh Mobile Payments) --------------------------------------
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_PRIVATE_KEY=""
NAGAD_PG_PUBLIC_KEY=""
NAGAD_BASE_URL="http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs"

# --- Monitoring / Error Tracking ---------------------------------------------
SENTRY_DSN=""

# --- Server ------------------------------------------------------------------
NODE_ENV="development"
PORT=4000
